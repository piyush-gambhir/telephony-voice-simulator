# Local control plane
SIMULATOR_BIND_HOST=127.0.0.1
SIMULATOR_BIND_PORT=8978
SIMULATOR_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional root for SQLite, compiled PSTN audio, and call artifacts. Installed
# wheels default to ./.telephony-voice-simulator; source checkouts use this app.
SIMULATOR_RUNTIME_DIR=
# These override individual folders beneath SIMULATOR_RUNTIME_DIR.
SIMULATOR_DATA_DIR=
SIMULATOR_RESULTS_DIR=
SIMULATOR_COMPILED_ASSETS_DIR=
# Optional external AMD YAML catalog (replaces the bundled AMD scenarios).
SIMULATOR_SCENARIOS_DIR=
# Private/local corpus directory and its matching provenance manifest. Public
# wheels and images intentionally contain no audio.
SIMULATOR_CORPUS_ASSETS_DIR=
SIMULATOR_CORPUS_MANIFEST=
SIMULATOR_PUBLIC_AUDIO_ALLOWLIST=
# Preferred explicit deployment-policy alias used by public AMD startup.
PSTN_AUDIO_DEPLOYMENT_ALLOWLIST=
# Preferred database selector. Leave empty for local SQLite, or use:
# mysql+pymysql://simulator:password@mysql:3306/telephony_voice_simulator
SIMULATOR_DATABASE_URI=
# Legacy/local SQLite path, used only when SIMULATOR_DATABASE_URI is empty.
SIMULATOR_DB_PATH=data/simulator.db
# Optional Twilio PSTN runtime
PUBLIC_BASE_URL=https://your-tunnel.example
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
IVR_CALLER_ID=
IVR_MAX_ATTEMPTS=3
PSTN_DEFAULT_SCENARIO=stock_voicemail_beep_1000
# JSON mapping from owned Twilio numbers to AMD scenario names.
PSTN_NUMBER_MAP={}
BRIDGE_NUMBER=
# Privacy-safe default. Enable only after satisfying notice, consent, retention,
# and deletion requirements for every jurisdiction involved.
PSTN_RECORD_ALL_CALLS=false
# Local testing only; never enable on a public deployment.
PSTN_ALLOW_UNSIGNED_WEBHOOKS=false
# Required for non-loopback AMD/PSTN serving after every referenced asset is
# checksum-bound and present in an explicit public-serving allowlist. Twilio
# fetches the generated audio through intentionally unauthenticated URLs.
PSTN_ACKNOWLEDGE_PUBLIC_AUDIO=false
# Used only when running telephony_voice_simulator.pstn.server directly.
PSTN_BIND_HOST=127.0.0.1
PSTN_BIND_PORT=8978

# Optional LiveKit adapter
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=
# Optional; omit to use the metadata template bundled with the package.
# METADATA_TEMPLATE=/absolute/path/to/outbound.metadata.json
SIM_NUMBER=
SIM_CALLER_ID=
AGENT_WEBHOOK_URL=

# Optional REST agent adapter (telephony_voice_simulator.agent_api) and the
# AMD benchmark suite that runs on top of it. Unlike the LiveKit adapter, this
# asks the agent's OWN backend to place the call, so the run exercises the
# prompt, model and answering-machine configuration production would resolve.
AGENT_API_TRIGGER_URL=
AGENT_API_TRIGGER_METHOD=POST
# Sent verbatim as the Authorization header. Keep real values out of this file.
AGENT_API_AUTHORIZATION=
# JSON request-body template; see config/agent-api.body.example.json.
AGENT_API_BODY=
# Dotted paths into the trigger response and the call record.
AGENT_API_CALL_ID_PATH=callId
AGENT_API_RECORD_URL=
AGENT_API_RECORD_AUTHORIZATION=
AGENT_API_STATUS_PATH=status
AGENT_API_TERMINAL_STATUSES=
AGENT_API_ENDED_REASON_PATH=
AGENT_API_DETECTION_LAYER_PATH=
AGENT_API_AMD_PATH=

# In-process LiveKit scenario runner webhook sink
WEBHOOK_BIND_HOST=127.0.0.1
WEBHOOK_BIND_PORT=8977
# Set when the agent cannot reach the local sink URL directly.
WEBHOOK_PUBLIC_URL=

# Hosted grading and corpus import
EXPECTED_VOICEMAIL_MESSAGE=
# Backward-compatible alias used by existing UAT environments.
UAT_EXPECTED_VOICEMAIL_MESSAGE=
RECORDINGS_BUCKET=

# Optional analysis, corpus, and prompt generation.
# Mailbox-message grading transcribes the recorded message. ElevenLabs is
# tried first (a deployment that synthesizes the corpus already has that key),
# then OpenAI. With neither, message_content grades as indeterminate.
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
# Required with ELEVENLABS_API_KEY. The corpus and IVR generators use this
# configured voice without storing the raw ID in generated provenance.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3
# Best-effort deterministic generation. Keep this stable to reproduce samples.
ELEVENLABS_SEED=42
# Optional JSON object passed to the ElevenLabs voice_settings request field.
# v3 default uses its Robust preset and neutral delivery.
ELEVENLABS_VOICE_SETTINGS_JSON='{"stability":1.0,"style":0.0,"speed":1.0}'
MACOS_TTS_VOICE=Samantha
# Local web builds only. Public builds must keep this false.
SIMULATOR_INCLUDE_LOCAL_AUDIO=false

# Preview provider
TELNYX_API_KEY=
