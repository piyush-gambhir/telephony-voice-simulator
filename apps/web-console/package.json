{
  "name": "web-console",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "content": "python3 ../../scripts/generate_content.py",
    "predev": "pnpm content",
    "prebuild": "pnpm content",
    "dev": "next dev",
    "dev:pstn": "next dev",
    "dev:ivr": "next dev",
    "build": "next build",
    "start": "python3 -m http.server 3000 --directory out",
    "start:api": "python3 -m http.server 3000 --directory out",
    "start:pstn": "python3 -m http.server 3000 --directory out",
    "start:ivr": "python3 -m http.server 3000 --directory out",
    "lint": "eslint .",
    "ui:check": "python3 ../../scripts/check_web_theme.py",
    "license:check": "python3 ../../scripts/check_javascript_licenses.py --project web",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "pretypecheck": "pnpm content"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "typescript7": "npm:typescript@7.0.2"
  }
}
