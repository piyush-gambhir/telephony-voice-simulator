ACCOUNT_SID=
AUTH_TOKEN=

# JSON object keyed by extension. Destinations may be E.164 numbers or SIP URIs.
EXTENSIONS_JSON={"1501":{"name":"Example desk","destination":"+15550101501","timeout":25}}
IVR_CALLER_ID=
IVR_MAX_ATTEMPTS=3
IVR_VOICE=Polly.Joanna
IVR_LANGUAGE=en-US

# Set true after generating assets with `npm run prompts`. Otherwise Twilio
# <Say> is used and no generated audio is required.
USE_PROMPT_ASSETS=false

# Optional TTS credentials used locally by `npm run prompts`; do not deploy
# credentials that the Function does not need.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
