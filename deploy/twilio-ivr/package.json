{
  "name": "telephony-voice-simulator-twilio-ivr",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "license": "Apache-2.0",
  "description": "Optional standalone Twilio Functions deployment for the clean-room IVR.",
  "scripts": {
    "start": "twilio-run start",
    "deploy": "twilio-run deploy",
    "prompts": "uv run --project ../../apps/simulator-backend telephony-voice-sim corpus prompts --output assets",
    "check:prompts": "uv run --project ../../apps/simulator-backend telephony-voice-sim corpus prompts --check",
    "test": "node --check functions/ivr.protected.js",
    "license:check": "python3 ../../scripts/check_javascript_licenses.py --project twilio",
    "audit:ci": "npm audit --audit-level=critical",
    "postinstall": "node scripts/security/apply-backports.cjs",
    "test:security": "node --test scripts/security/verify-backports.cjs",
    "pretest": "npm run test:security",
    "prestart": "npm run test:security",
    "predeploy": "npm run test:security"
  },
  "devDependencies": {
    "twilio-run": "5.0.1"
  }
}
